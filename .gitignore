# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Log files (see LOG_FILE in .env.example) — local runtime output.
/logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js generated type-checking files (do not edit manually, regenerated on dev/build)
/types/routes.d.ts
/types/validator.ts
/types/cache-life.d.ts
