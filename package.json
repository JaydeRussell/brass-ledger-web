{
  "name": "brass-ledger-web",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --experimental-loader=./scripts/tsx-test-loader.mjs --experimental-test-module-mocks --test",
    "dev:vinext": "vinext dev --port 3001",
