# This app's own backend (brass-ledger-api), which proxies and caches
# Best Coast Pairings' data — see app/lib/bcp.ts. Next.js inlines
# NEXT_PUBLIC_* vars at build time, and the *browser* is what calls this
# URL (not the Next.js server), so it must be reachable from wherever the
# browser runs — http://localhost:8080 covers both `go run ./cmd/server`
# and the Docker Compose stack, since the backend's port is published to
# the host either way.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

